{
  "manifest_version": 3,
  "name": "AI Thread to Markdown",
  "short_name": "Thread → MD",
  "version": "1.1.0",
  "description": "Right-click a Claude or Perplexity thread, or an AI search answer (Google, Bing, Brave, DuckDuckGo, You.com, Kagi), to save or copy it as clean Markdown.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save this AI thread as Markdown",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "scripting",
    "downloads",
    "storage",
    "activeTab",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.perplexity.ai/*",
    "https://www.google.com/*",
    "https://www.google.co.uk/*",
    "https://www.google.de/*",
    "https://www.google.fr/*",
    "https://www.google.ca/*",
    "https://www.google.com.au/*",
    "https://www.google.es/*",
    "https://www.google.it/*",
    "https://www.google.nl/*",
    "https://www.google.co.in/*",
    "https://www.google.co.jp/*",
    "https://www.google.com.br/*",
    "https://www.bing.com/*",
    "https://search.brave.com/*",
    "https://duckduckgo.com/*",
    "https://*.you.com/*",
    "https://you.com/*",
    "https://kagi.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.perplexity.ai/*",
        "https://www.google.com/*",
        "https://www.google.co.uk/*",
        "https://www.google.de/*",
        "https://www.google.fr/*",
        "https://www.google.ca/*",
        "https://www.google.com.au/*",
        "https://www.google.es/*",
        "https://www.google.it/*",
        "https://www.google.nl/*",
        "https://www.google.co.in/*",
        "https://www.google.co.jp/*",
        "https://www.google.com.br/*",
        "https://www.bing.com/*",
        "https://search.brave.com/*",
        "https://duckduckgo.com/*",
        "https://*.you.com/*",
        "https://you.com/*",
        "https://kagi.com/*"
      ],
      "js": [
        "content/shortcut.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "commands": {
    "save-thread": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Save the current thread as Markdown"
    },
    "copy-thread": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy the current thread as Markdown"
    }
  }
}
